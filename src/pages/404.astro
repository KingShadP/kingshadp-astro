---
import HouseLayout from "../layouts/HouseLayout.astro";
---

<HouseLayout
	title="Room Not Found | KingShadP"
	description="The requested KingShadP room could not be found."
>
	<section class="not-found">
		<div>
			<h1>404</h1>
			<p>This door does not open to an active room. Return to the house directory or enter through one of the official rooms.</p>
			<div class="room-actions">
				<a class="button button--primary" href="/">Return Home</a>
				<a class="button" href="/music">Enter Music</a>
			</div>
		</div>
	</section>
</HouseLayout>
