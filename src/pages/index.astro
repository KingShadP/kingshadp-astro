---
import HouseLayout from "../layouts/HouseLayout.astro";
import RoomHero from "../components/RoomHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ContactBand from "../components/ContactBand.astro";
import {
	backgrounds,
	drops,
	houseRoutes,
	oracleEntries,
	symbols,
	visualItems,
} from "../data/house";

const featuredVisual = visualItems[0];
const featuredOracle = oracleEntries.find((entry) => entry.featured) ?? oracleEntries[0];
---

<HouseLayout
	title="KingShadP | Music, Visuals, Writing, and the Official Creative House"
	description="The official house of KingShadP: music, visual campaigns, writing, symbols, artifacts, and direct contact."
	image="/images/backgrounds/bg-house-hero.webp"
	pageClass="home-page"
>
	<div class="bootloader" data-bootloader>
		<div class="bootloader__inner">
			<img src="/images/00_SOURCE_SP_CREST_TRANSPARENT.png" alt="" />
			<p>KingShadP / The House Is Opening</p>
			<h2 data-boot-message>Opening Sonic Room</h2>
			<div class="boot-line" aria-hidden="true"></div>
			<button type="button" data-skip-boot>Skip opening</button>
		</div>
	</div>

	<RoomHero
		humanTitle="The Official Creative House"
		kicker="Music first. The world follows."
		title="KingShadP"
		copy="Music. Image. Story. World. This is the official home for the releases, visual work, writing, symbols, objects, and active record of KingShadP."
		background={backgrounds.home}
		actions={[
			{ label: "Listen", href: "#featured-music", primary: true },
			{ label: "View Visuals", href: "/visuals" },
			{ label: "Read Oracle", href: "/oracle" },
			{ label: "Contact", href: "/contact" },
		]}
		nextLabel="See what exists now"
	/>

	<section class="content-section" id="room-content">
		<div class="section-inner">
			<SectionHeading
				label="House Directory"
				title="What Exists Now"
				copy="Seven rooms hold the current body of work. Enter by medium, subject, or intent."
			/>
			<nav class="house-map" aria-label="Explore the KingShadP house">
				{houseRoutes.map((route, index) => (
					<a href={route.href}>
						<small>{String(index + 1).padStart(2, "0")} / {route.room}</small>
						<strong>{route.label}</strong>
						<span>{route.description}</span>
					</a>
				))}
			</nav>
		</div>
	</section>

	<section class="content-section content-section--soft" id="featured-music">
		<div class="section-inner music-feature">
			<div class="music-cover">
				<video autoplay muted loop playsinline poster="/images/giragon.png">
					<source src="/signal-motion.mp4" type="video/mp4" />
				</video>
			</div>
			<div class="music-copy">
				<p>Featured Sound / 2026</p>
				<h2>The Liturgy of Shad P I</h2>
				<span>
					A house statement in sound. The piece sets the tone for everything around it:
					composed, ceremonial, direct, and built to carry weight without explanation.
				</span>
				<audio class="audio-player" controls preload="metadata">
					<source src="/audio/liturgy-of-shad-p-web.wav" type="audio/wav" />
				</audio>
				<div class="text-links">
					<a href="/music">Enter the Sonic Room</a>
					<a href="/oracle">Read the written record</a>
				</div>
			</div>
		</div>
	</section>

	<section class="content-section">
		<div class="section-inner visual-feature">
			<figure>
				<img src={featuredVisual.image} alt="KingShadP Giragon Collection campaign" loading="lazy" />
			</figure>
			<div class="feature-copy">
				<p class="feature-label">Visual Room / Featured Campaign</p>
				<h2>{featuredVisual.title}</h2>
				<p>{featuredVisual.description} The full room holds editorial, garment, symbol, campaign, and artifact studies.</p>
				<div class="text-links">
					<a href="/visuals">Open the visual archive</a>
				</div>
			</div>
		</div>
	</section>

	<section class="content-section content-section--soft">
		<div class="section-inner oracle-preview">
			<p class="feature-label">Oracle / Current Statement</p>
			<blockquote>“{featuredOracle.excerpt}”</blockquote>
			<p>{featuredOracle.title} · {featuredOracle.date}</p>
			<div class="room-actions">
				<a class="button" href="/oracle">Read the Oracle</a>
			</div>
		</div>
	</section>

	<section class="content-section">
		<div class="section-inner world-feature">
			<img src={symbols[0].image} alt="The KingShadP Giragon symbol" loading="lazy" />
			<div class="feature-copy">
				<p class="feature-label">The World / Primary Symbol</p>
				<h2>{symbols[0].name}</h2>
				<p>{symbols[0].meaning}</p>
				<div class="text-links">
					<a href="/world">Read the symbol system</a>
				</div>
			</div>
		</div>
	</section>

	<section class="content-section content-section--soft">
		<div class="section-inner">
			<SectionHeading
				label="Drop Vault"
				title="Objects From the House"
				copy="A working record of garment ideas, presentation pieces, writing objects, and physical studies."
			/>
			<div class="artifact-rail">
				{drops.slice(0, 3).map((drop) => (
					<article class="artifact-card">
						<img src={drop.image} alt={drop.name} loading="lazy" />
						<div>
							<small>{drop.type} / {drop.status}</small>
							<h3>{drop.name}</h3>
						</div>
					</article>
				))}
			</div>
			<div class="text-links">
				<a href="/drops">Open the Drop Vault</a>
			</div>
		</div>
	</section>

	<section class="content-section content-section--light">
		<div class="section-inner feature-split">
			<div class="feature-media">
				<img src="/images/kingshad3.png" alt="KingShadP portrait" loading="lazy" />
			</div>
			<div class="feature-copy">
				<p class="feature-label">About KingShadP</p>
				<h2>Artist. Writer. Builder of the House.</h2>
				<p>
					KingShadP works across music, visual direction, writing, identity, garments, and
					digital space. Every room exists to make the work easier to understand, inspect,
					and take seriously.
				</p>
				<div class="text-links">
					<a href="/about">Read the official profile</a>
				</div>
			</div>
		</div>
	</section>

	<ContactBand
		title="The work is public. The right conversations can be direct."
		copy="Press, booking, music collaboration, visuals, creative direction, partnerships, and serious business inquiries."
	/>
</HouseLayout>

<script>
	const loader = document.querySelector<HTMLElement>("[data-bootloader]");
	const skip = document.querySelector<HTMLButtonElement>("[data-skip-boot]");
	const message = document.querySelector<HTMLElement>("[data-boot-message]");
	const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	const hasOpened = window.localStorage.getItem("ksp-house-opened") === "1";
	const messages = [
		"Opening Sonic Room",
		"Loading Visual Room",
		"Opening Oracle",
		"Verifying Symbols",
		"House Online",
	];

	const complete = () => {
		if (!loader) return;
		loader.classList.add("is-complete");
		window.localStorage.setItem("ksp-house-opened", "1");
		window.setTimeout(() => loader.remove(), 650);
	};

	if (hasOpened || reducedMotion) {
		loader?.remove();
	} else {
		let index = 0;
		const interval = window.setInterval(() => {
			index += 1;
			if (message && messages[index]) message.textContent = messages[index];
			if (index >= messages.length - 1) {
				window.clearInterval(interval);
				window.setTimeout(complete, 280);
			}
		}, 430);
		skip?.addEventListener("click", () => {
			window.clearInterval(interval);
			complete();
		});
	}
</script>
