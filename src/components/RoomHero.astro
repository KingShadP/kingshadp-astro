---
interface Action {
	label: string;
	href: string;
	primary?: boolean;
}

interface Props {
	humanTitle?: string;
	title: string;
	kicker?: string;
	copy: string;
	background: string;
	align?: "left" | "center" | "right";
	actions?: Action[];
	priority?: boolean;
	nextLabel?: string;
	compact?: boolean;
}

const {
	humanTitle,
	title,
	kicker,
	copy,
	background,
	align = "left",
	actions = [],
	priority = true,
	nextLabel = "Explore the room",
	compact = false,
} = Astro.props;

const baseName = background.split("/").at(-1);
const mobileBase = `/images/backgrounds/mobile/${baseName}-mobile`;
---

<section class:list={["room-hero", `room-hero--${align}`, { "room-hero--compact": compact }]} data-room-camera>
	<div class="room-hero__stage">
		<picture class="room-hero__media" aria-hidden="true">
			<source media="(max-width: 767px)" type="image/avif" srcset={`${mobileBase}.avif`} />
			<source media="(max-width: 767px)" type="image/webp" srcset={`${mobileBase}.webp`} />
			<source type="image/avif" srcset={`${background}.avif`} />
			<img
				src={`${background}.webp`}
				alt=""
				loading={priority ? "eager" : "lazy"}
				decoding="async"
				fetchpriority={priority ? "high" : "auto"}
			/>
		</picture>
		<div class="room-hero__depth" aria-hidden="true"></div>
		<div class="room-hero__light" aria-hidden="true"></div>
		<div class="room-hero__reflection" aria-hidden="true"></div>
		<div class="room-hero__shade" aria-hidden="true"></div>
		<div class="room-hero__mist" aria-hidden="true"></div>

		<div class="room-hero__inner">
			<div class="room-hero__copy">
				{humanTitle && <p class="room-human-title">{humanTitle}</p>}
				{kicker && <p class="room-kicker">{kicker}</p>}
				<h1>{title}</h1>
				<p class="room-description">{copy}</p>
				{actions.length > 0 && (
					<div class="room-actions">
						{actions.map((action) => (
							<a class:list={["button", { "button--primary": action.primary }]} href={action.href}>{action.label}</a>
						))}
					</div>
				)}
			</div>
		</div>

		<a class="room-peek" href="#room-content">
			<span>{nextLabel}</span>
			<i aria-hidden="true"></i>
		</a>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>("[data-room-camera]").forEach((room) => {
		const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		let frame = 0;
		const update = () => {
			const rect = room.getBoundingClientRect();
			const travel = Math.max(1, room.offsetHeight - window.innerHeight);
			const progress = reduced ? 0 : Math.min(1, Math.max(0, -rect.top / travel));
			room.style.setProperty("--room-progress", progress.toFixed(4));
		};
		const requestUpdate = () => {
			cancelAnimationFrame(frame);
			frame = requestAnimationFrame(update);
		};
		update();
		window.addEventListener("scroll", requestUpdate, { passive: true });
		window.addEventListener("resize", requestUpdate);
	});
</script>
