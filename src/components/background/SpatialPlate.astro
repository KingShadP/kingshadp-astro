---
interface Props {
	background: string;
	className?: string;
	index?: number;
	priority?: boolean;
	active?: boolean;
}

const {
	background,
	className = "",
	index,
	priority = false,
	active = false,
} = Astro.props;

const baseName = background.split("/").at(-1);
const mobileBase = `/images/backgrounds/mobile/${baseName}-mobile`;
---

<picture
	class:list={["spatial-plate", className, { "is-active": active }]}
	data-scene-index={index}
	aria-hidden="true"
>
	<source media="(max-width: 767px)" type="image/avif" srcset={`${mobileBase}.avif`} />
	<source media="(max-width: 767px)" type="image/webp" srcset={`${mobileBase}.webp`} />
	<source type="image/avif" srcset={`${background}.avif`} />
	<img
		src={`${background}.webp`}
		alt=""
		loading={priority ? "eager" : "lazy"}
		decoding="async"
		fetchpriority={priority ? "high" : "auto"}
	/>
</picture>
