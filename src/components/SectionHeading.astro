---
interface Props {
	label?: string;
	title: string;
	copy?: string;
	align?: "left" | "center";
}

const { label, title, copy, align = "left" } = Astro.props;
---

<header class:list={["section-heading", `section-heading--${align}`]}>
	{label && <p>{label}</p>}
	<h2>{title}</h2>
	{copy && <div>{copy}</div>}
</header>
