---
import { backgrounds } from "../data/house";
import SpatialAtmosphere from "./background/SpatialAtmosphere.astro";
import SpatialPlate from "./background/SpatialPlate.astro";

const rooms = [
	{ label: "The House", title: "KingShadP", copy: "Music. Image. Story. World. The official creative house of KingShadP.", background: backgrounds.home, href: "/" },
	{ label: "Sonic Room", title: "Music", copy: "The sound is the center. Releases, lyrics, demos, and the work behind the record.", background: backgrounds.music, href: "/music" },
	{ label: "Visual Room", title: "Visuals", copy: "Campaigns, editorial work, garments, symbols, objects, and motion.", background: backgrounds.visuals, href: "/visuals" },
	{ label: "Oracle", title: "Writing", copy: "Statements, lyrics, fragments, documents, and the internal record.", background: backgrounds.oracle, href: "/oracle" },
	{ label: "The World", title: "Symbols", copy: "Giragon, SP Crest, signature, meanings, and the rules of the house.", background: backgrounds.world, href: "/world" },
	{ label: "Contact", title: "Contact", copy: "Press, booking, collaboration, partnerships, and direct business inquiries.", background: backgrounds.contact, href: "/contact" },
];
---

<section class="house-journey" data-house-journey>
	<div class="house-journey__stage">
		<div class="house-journey__plates" aria-hidden="true">
			{rooms.map((room, index) => (
				<SpatialPlate
					background={room.background}
					className="house-journey__plate"
					index={index}
					priority={index === 0}
					active={index === 0}
				/>
			))}
		</div>
		<SpatialAtmosphere />

		<div class="house-journey__content">
			{rooms.map((room, index) => (
				<div class:list={["house-journey__copy", { "is-active": index === 0 }]} data-journey-copy={index}>
					<p>{String(index + 1).padStart(2, "0")} / {room.label}</p>
					<h1>{room.title}</h1>
					<span>{room.copy}</span>
					{index === 0 && (
						<div class="room-actions">
							<a class="button button--primary" href="/music">Listen</a>
							<a class="button" href="/visuals">View Visuals</a>
							<a class="button" href="/oracle">Read Oracle</a>
							<a class="button" href="/contact">Contact</a>
						</div>
					)}
					{index > 0 && <a class="journey-room-link" href={room.href}>Enter {room.label}</a>}
				</div>
			))}
		</div>

		<div class="house-journey__meter" aria-label="House entry progress">
			<span>Enter the House</span>
			<i><b data-journey-meter></b></i>
			<span data-journey-count>01 / {String(rooms.length).padStart(2, "0")}</span>
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>("[data-house-journey]").forEach((journey) => {
		const plates = Array.from(journey.querySelectorAll<HTMLElement>("[data-scene-index]"));
		const copies = Array.from(journey.querySelectorAll<HTMLElement>("[data-journey-copy]"));
		const meter = journey.querySelector<HTMLElement>("[data-journey-meter]");
		const count = journey.querySelector<HTMLElement>("[data-journey-count]");
		const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		let frame = 0;

		const update = () => {
			const rect = journey.getBoundingClientRect();
			const travel = Math.max(1, journey.offsetHeight - window.innerHeight);
			const progress = reduced ? 0 : Math.min(1, Math.max(0, -rect.top / travel));
			const position = progress * Math.max(1, plates.length - 1);
			const roomIndex = Math.min(plates.length - 1, Math.round(position));
			journey.style.setProperty("--journey-progress", progress.toFixed(4));
			journey.style.setProperty("--camera-progress", progress.toFixed(4));
			plates.forEach((plate, index) => {
				const phase = Math.max(-1, Math.min(1, position - index));
				const focus = Math.max(0, 1 - Math.abs(phase));
				const opacity = focus * focus * (3 - (2 * focus));
				const push = Math.max(0, Math.min(1, phase + 0.5));
				plate.style.setProperty("--scene-phase", phase.toFixed(4));
				plate.style.setProperty("--scene-focus", focus.toFixed(4));
				plate.style.setProperty("--scene-opacity", opacity.toFixed(4));
				plate.style.setProperty("--scene-push", push.toFixed(4));
				plate.classList.toggle("is-active", index === roomIndex);
			});
			copies.forEach((copy, index) => {
				const phase = Math.max(-1, Math.min(1, position - index));
				const focus = Math.max(0, 1 - Math.abs(phase));
				const opacity = focus * focus * (3 - (2 * focus));
				copy.style.setProperty("--scene-phase", phase.toFixed(4));
				copy.style.setProperty("--scene-focus", focus.toFixed(4));
				copy.style.setProperty("--scene-opacity", opacity.toFixed(4));
				copy.classList.toggle("is-active", index === roomIndex);
			});
			if (meter) meter.style.transform = `scaleX(${progress})`;
			if (count) count.textContent = `${String(roomIndex + 1).padStart(2, "0")} / ${String(plates.length).padStart(2, "0")}`;
		};

		const requestUpdate = () => {
			cancelAnimationFrame(frame);
			frame = requestAnimationFrame(update);
		};

		update();
		window.addEventListener("scroll", requestUpdate, { passive: true });
		window.addEventListener("resize", requestUpdate);
	});
</script>
